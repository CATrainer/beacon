# ============================================================================
# Beacon — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values as you obtain them.
# The app boots and runs locally with NONE of the optional keys set — every
# external integration degrades gracefully and tells you in the UI when a key
# is missing. Fill these in incrementally; nothing here blocks local dev.
#
# Secrets live ONLY in this file (git-ignored) or in your host's env / Railway
# variables. Never commit real values.
# ============================================================================

# --- Core (required; sensible local defaults already baked into compose) -----
# Postgres connection. In Docker compose this is set for you; override for prod.
DATABASE_URL=postgresql+psycopg://beacon:beacon@db:5432/beacon
# Redis (used by the background worker queue in Slice 2+). Optional until then.
REDIS_URL=redis://redis:6379/0

# JWT signing secret for auth sessions. CHANGE THIS for any non-local use.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# Access token lifetime (minutes). 2-person internal tool — long sessions are fine.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# Environment name: local | production
APP_ENV=local

# --- AI models (Slice 4+). App reads these per stage so you can tune cheaply. -
# Default tier (research synthesis, drafting): Sonnet. High-ROI: Opus. Bulk: Haiku.
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-4-6
MODEL_HIGH=claude-opus-4-8
MODEL_CHEAP=claude-haiku-4-5
# Stage-4 research auto-runs only on the top-N leads by Stage-3 score.
RESEARCH_TOP_N_DEFAULT=50

# --- Scheduled incremental sourcing (worker cron) ----------------------------
# When enabled, the worker tops up active lanes daily, pulling NEW records each
# run (resumes from a per-source cursor). Toggle/limit also editable in Settings;
# the hour is read at worker start, so change it here + restart the worker.
SCHEDULED_SOURCING_ENABLED=false
SCHEDULED_SOURCING_HOUR=2
SCHEDULED_SOURCING_LIMIT=50

# --- Source adapters (Slice 2). All optional; adapters skip if unset. --------
CQC_SUBSCRIPTION_KEY=
GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=
# ATOL data-download has no API key; the adapter fetches the published file.

# --- GEO engines (Slice 5). All optional; each degrades independently. -------
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Email verification backstop (Slice 4). Optional; off by default. --------
EMAIL_RESOLVER_PROVIDER=
HUNTER_API_KEY=

# --- Sending (Slice 7). Gmail OAuth client for draft creation. ---------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
SENDING_IDENTITY=caleb.trainer@heuricity.com

# --- Booking (Slice 8). Cal.com link embedded in emails + webhook secret. ----
CAL_LINK=
CAL_WEBHOOK_SECRET=

# --- Fetching etiquette (used by all web fetchers) ---------------------------
USER_AGENT=HeuricityBeacon/1.0; hello@heuricity.com
FETCH_MAX_RPS_PER_HOST=1
